App(
    appid="subghz",
    name="Sub-GHz",
    apptype=FlipperAppType.APP,
    targets=["f7"],
    cdefines=["APP_SUBGHZ"],
    entry_point="subghz_app",
    requires=[
        "gui",
        "cli",
        "dialogs",
    ],
    provides=[
        "subghz_load_dangerous_settings",
    ],
    icon="A_Sub1ghz_14",
    stack_size=3 * 1024,
    order=1,
    resources="resources",
    sources=[
        "*.c*",
        "!plugins",
        "!subghz_scene_set_type.c",
        "!subghz_scene_set_key.c",
        "!subghz_scene_set_serial.c",
        "!subghz_scene_set_button.c",
        "!subghz_scene_set_counter.c",
        "!subghz_scene_set_seed.c",
        "!subghz_gen_info.c",
        "!subghz_txrx_create_protocol_key.c",
        "!subghz_scene_clean_dupes.c",
    ],
    fap_libs=["assets", "hwdrivers"],
    fap_icon="icon.png",
    fap_category="Sub-GHz",
)

App(
    appid="cli_subghz",
    targets=["f7"],
    apptype=FlipperAppType.PLUGIN,
    entry_point="cli_subghz_ep",
    requires=["cli"],
    sources=[
        "subghz_cli.c",
        "helpers/subghz_chat.c",
    ],
)

App(
    appid="subghz_load_dangerous_settings",
    apptype=FlipperAppType.STARTUP,
    entry_point="subghz_dangerous_freq",
    requires=["storage", "subghz"],
    order=650,
)

App(
    appid="subghz_frequency_analyzer",
    apptype=FlipperAppType.PLUGIN,
    targets=["f7"],
    entry_point="subghz_frequency_analyzer_ep",
    requires=["subghz"],
    sources=["plugins/frequency_analyzer/*.c"],
    fap_libs=["assets", "hwdrivers"],
    fap_exclude_libs=["gcc"],
)

App(
    appid="subghz_add_manually",
    apptype=FlipperAppType.PLUGIN,
    targets=["f7"],
    entry_point="subghz_add_manually_ep",
    requires=["subghz"],
    sources=[
        "plugins/add_manually/*.c",
        "scenes/subghz_scene_set_type.c",
        "scenes/subghz_scene_set_key.c",
        "scenes/subghz_scene_set_serial.c",
        "scenes/subghz_scene_set_button.c",
        "scenes/subghz_scene_set_counter.c",
        "scenes/subghz_scene_set_seed.c",
        "helpers/subghz_gen_info.c",
        "helpers/subghz_txrx_create_protocol_key.c",
    ],
    fap_libs=["assets", "hwdrivers"],
    fap_exclude_libs=["gcc"],
)

App(
    appid="subghz_clean_dupes",
    apptype=FlipperAppType.PLUGIN,
    targets=["f7"],
    entry_point="subghz_clean_dupes_ep",
    requires=["subghz"],
    sources=[
        "plugins/clean_dupes/*.c",
        "scenes/subghz_scene_clean_dupes.c",
    ],
    fap_libs=["assets", "hwdrivers"],
    fap_exclude_libs=["gcc"],
)
