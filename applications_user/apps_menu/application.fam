App(
    appid="apps_menu",
    name="Apps Menu",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="apps_menu_app",
    requires=["gui", "storage", "loader"],
    stack_size=8 * 1024,
    sources=["*.c*", "!tools"],
    fap_icon="icon.png",
    fap_icon_assets="icons",
    fap_exclude_libs=["gcc"],
    fap_category="Tools",
    fap_version="1.3",
    fap_description="Browses the apps on the SD card as category and app menus, drawn as the stock main menu list, instead of as a file tree",
)
