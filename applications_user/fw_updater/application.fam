App(
    appid="fw_updater",
    name="Firmware",
    apptype=FlipperAppType.MENUEXTERNAL,
    entry_point="fw_updater_app",
    requires=[
        "gui",
        "storage",
        "notification",
    ],
    stack_size=4 * 1024,
    order=90,
    icon="A_Firmware_14",
    fap_icon="icon.png",
    fap_icon_assets="icons",
    fap_exclude_libs=["gcc"],
    fap_category="Tools",
    fap_author="@thedoctorz",
    fap_weburl="https://github.com/thedoctorz/doctor-firmware",
    fap_version="1.0",
    fap_description="Browse, verify and install firmware packages from the SD card, .tgz bundles included",
)
